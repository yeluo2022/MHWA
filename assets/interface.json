                        "选择超限共鸣关卡": {
                            "template": "超限共鸣1.png"
                        },
                        "确认超限共鸣关卡": {
                            "expected": "逆爱"
                        },
                        "点击关卡": {
                            "template": "关卡-05.png"
                        }
                    }
                },
                {
                    "name": "索贝克",
