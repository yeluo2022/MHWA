{
    "name": "MHWA",
    "url": "https://github.com/yeluo2022/MHWA",
    "mirrorchyan_rid": null,
    "mirrorchyan_multiplatform": false,
    "custom_title": "MHWA苍雾世界小助手",
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource/base"
            ]
        }
    ],
    "task": [
        {
            "name": "启动游戏",
            "entry": "进入主页"
        },
        {
            "name": "指挥室",
            "entry": "指挥室",
            "doc": "指挥室远征暂时仅支持重复之前的选项出击，如有自定义需求请关闭此功能，也可反馈需求"
        },
        {
            "name": "每日免费礼包",
            "entry": "每日免费礼包"
        },
        {
            "name": "演习",
            "entry": "演习",
            "option": [
                "代理作战",
                "补充票（不消耗结晶）"
            ]
        },
        {
            "name": "领取奖励",
            "entry": "领取奖励",
            "option": [
                "任务奖励",
                "通行证奖励",
                "邮箱奖励",
                "支援角色友情币"
            ]
        },
        {
            "name": "好友点赞",
            "entry": "好友点赞"
        },
        {
            "name": "超限共鸣关卡",
            "entry": "装甲进阶",
            "option": [
                "选择超限共鸣关卡"
            ]
        },
        {
            "name": "作战",
            "entry": "作战",
            "option": [
                "关卡选择"
            ],
            "doc": "作战暂时只支持最大次数扫荡"
        },
        {
            "name": "商店资源购买",
            "entry": "商店资源购买",
            "option": [
                "兑换商店（精英和后勤）",
                "荣誉凭证"
            ],
            "doc": "暂时仅支持兑换商店中精英和后勤商店，以及荣誉凭证商店\n精英商店优先兑换每周更新的演习券，其次将剩余高价值物资全部兑换\n后勤商店除盾币外默认全换\n荣誉凭证商店仅兑换常驻票及高价值物资\n可能有bug，如有遇到请反馈"
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏"
        }
    ],
    "option": {
        "任务奖励": {
            "cases": [
                {
                    "name": "是",
                    "pipeline_override": {
                        "任务奖励": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "否",
                    "pipeline_override": {
                        "任务奖励": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "通行证奖励": {
            "cases": [
                {
                    "name": "是",
                    "pipeline_override": {
                        "通行证奖励": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "否",
                    "pipeline_override": {
                        "通行证奖励": {
                            "enabled": false
                        }
                    }
